
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap');

:root {
  font-family: 'DM Sans', sans-serif;
  color: #e8edf5;
  background: #080d16;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  scroll-behavior: smooth;
  --bg: #080d16;
  --card: #101a28;
  --border: #202d3e;
  --muted: #91a0b4;
  --green: #42e8a0;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  min-width: 320px;
  background: var(--bg);
}

a {
  color: inherit;
  text-decoration: none;
}

button, a {
  transition: 0.25s ease;
}

.container {
  width: min(1120px, 90%);
  margin: auto;
}

.navbar {
  height: 82px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 5%;
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(8, 13, 22, 0.94);
  backdrop-filter: blur(15px);
}

.logo {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 28px;
  font-weight: 700;
}

.logo span {
  color: var(--green);
}

.navbar nav {
  display: flex;
  gap: 30px;
}

.navbar nav a,
.nav-contact {
  font-size: 13px;
  color: var(--muted);
}

.navbar nav a:hover,
.nav-contact:hover {
  color: var(--green);
}

.nav-contact span {
  color: var(--green);
}

.hero {
  min-height: 650px;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 45px;
  padding-top: 70px;
  padding-bottom: 90px;
}

.availability {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 9px 14px;
  border: 1px solid #235541;
  border-radius: 30px;
  color: var(--green);
  font-size: 10px;
  letter-spacing: 1px;
  margin-bottom: 28px;
}

.status-dot {
  height: 7px;
  width: 7px;
  background: var(--green);
  border-radius: 50%;
  box-shadow: 0 0 10px var(--green);
}

.hero-intro, .eyebrow {
  color: var(--green);
  letter-spacing: 2px;
  font-size: 11px;
  font-weight: 700;
}

.hero h1 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: clamp(45px, 6vw, 74px);
  line-height: 1.08;
  letter-spacing: -3px;
  margin: 20px 0;
}

.hero h1 span {
  color: var(--green);
}

.hero-description {
  color: var(--muted);
  line-height: 1.9;
  max-width: 510px;
  font-size: 15px;
}

.hero-buttons {
  display: flex;
  gap: 15px;
  margin-top: 32px;
}

.btn-primary, .btn-secondary {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 12px;
  padding: 15px 22px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 700;
}

.btn-primary {
  background: var(--green);
  color: #07140f;
}

.btn-primary:hover {
  background: #7dffc0;
  transform: translateY(-3px);
}

.btn-secondary {
  border: 1px solid var(--border);
}

.btn-secondary:hover {
  border-color: var(--green);
  color: var(--green);
}

.hero-socials {
  display: flex;
  gap: 25px;
  margin-top: 35px;
  color: var(--muted);
  font-size: 12px;
}

.hero-socials a:hover {
  color: var(--green);
}

.hero-visual {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 390px;
}

.visual-glow {
  position: absolute;
  width: 300px;
  height: 300px;
  background: #15b978;
  opacity: 0.12;
  filter: blur(100px);
  border-radius: 50%;
}

.code-window {
  width: 100%;
  max-width: 440px;
  background: #0d1623;
  border: 1px solid #2a3c4e;
  border-radius: 12px;
  position: relative;
  z-index: 1;
  overflow: hidden;
  box-shadow: 0 30px 90px #0008;
  transform: rotate(-2deg);
}

.window-header {
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 17px;
  border-bottom: 1px solid var(--border);
  color: var(--muted);
  font-size: 10px;
}

.window-dots {
  display: flex;
  gap: 5px;
}

.window-dots span {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #f16c65;
}

.window-dots span:nth-child(2) { background: #edc15b; }
.window-dots span:nth-child(3) { background: #52cf91; }

.code-content {
  padding: 27px 15px;
  font-family: Consolas, monospace;
  font-size: clamp(10px, 1.2vw, 12px);
  line-height: 2.2;
  white-space: nowrap;
}

.code-muted { color: #62738a; }
.code-purple { color: #c69cff; }
.code-green { color: #5de2a5; }
.code-yellow { color: #eacb83; }
.terminal-line { color: #a5b4c7; }
.terminal-success { color: var(--green); }

.floating-tag {
  position: absolute;
  z-index: 2;
  padding: 12px 17px;
  border: 1px solid #315344;
  border-radius: 7px;
  background: #101d2b;
  font-size: 11px;
  box-shadow: 0 10px 30px #0005;
}

.tag-top { top: 12%; right: -4%; }
.tag-bottom { bottom: 12%; left: -4%; }

.tech-strip {
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  background: #0c131e;
}

.tech-inner {
  min-height: 90px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}

.tech-inner span {
  font-family: 'Space Grotesk', sans-serif;
  color: #8997a9;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1px;
}

.section {
  padding-top: 110px;
  padding-bottom: 110px;
}

.section-heading {
  margin-bottom: 48px;
}

.section-heading h2, .contact-section h2 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: clamp(30px, 4vw, 44px);
  letter-spacing: -1.5px;
  margin: 15px 0;
}

.section-heading p, .contact-section > p {
  color: var(--muted);
  line-height: 1.8;
  font-size: 14px;
  max-width: 620px;
}

.about-grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 60px;
}

.about-main h3 {
  font-size: 23px;
  line-height: 1.5;
  margin-bottom: 20px;
  font-family: 'Space Grotesk', sans-serif;
}

.about-main p {
  color: var(--muted);
  line-height: 1.9;
  font-size: 14px;
  margin-bottom: 15px;
}

.about-card, .skill-card, .project-card, .experience-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 10px;
}

.about-card {
  padding: 28px;
}

.card-label {
  color: var(--green);
  font-size: 10px;
  letter-spacing: 2px;
}

.focus-item {
  display: flex;
  gap: 20px;
  padding: 19px 0;
  border-bottom: 1px solid var(--border);
  color: var(--green);
  font-size: 12px;
}

.focus-item:last-child { border-bottom: 0; }
.focus-item span { color: #d9e1ec; }

.section-alt {
  background: #0c131e;
}

.skills-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

.skill-card {
  padding: 28px;
}

.skill-card h3 {
  font-size: 16px;
  margin-bottom: 22px;
}

.skill-tags, .project-tags {
  display: flex;
  gap: 9px;
  flex-wrap: wrap;
}

.skill-tags span, .project-tags span {
  border: 1px solid #304155;
  background: #152233;
  color: #b5c4d7;
  border-radius: 5px;
  padding: 8px 11px;
  font-size: 11px;
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

.project-card {
  padding: 28px;
  transition: 0.3s;
}

.project-card:hover {
  transform: translateY(-5px);
  border-color: #398a69;
}

.project-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 28px;
}

.project-number, .project-arrow {
  color: var(--green);
  font-size: 20px;
  font-weight: 700;
}

.project-type {
  color: var(--green);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.project-card h3 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 21px;
  margin: 12px 0;
}

.project-card > p {
  color: var(--muted);
  line-height: 1.8;
  font-size: 13px;
  min-height: 70px;
  margin-bottom: 22px;
}

.project-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid var(--border);
  padding-top: 18px;
  margin-top: 22px;
  font-size: 11px;
}

.project-status { color: #e6c17b; }
.project-bottom a { color: var(--green); }

.experience-card {
  padding: 30px;
  display: grid;
  grid-template-columns: 220px 1fr;
  gap: 25px;
  margin-bottom: 18px;
}

.experience-date {
  color: var(--green);
  font-size: 11px;
  letter-spacing: 1px;
}

.experience-card h3 {
  font-size: 20px;
  margin-bottom: 8px;
}

.experience-company {
  color: var(--green) !important;
  font-size: 12px !important;
  margin-bottom: 15px;
}

.experience-card p {
  color: var(--muted);
  line-height: 1.8;
  font-size: 13px;
  margin-bottom: 18px;
}

.education-card { margin-bottom: 0; }

.contact-section {
  text-align: center;
  padding-top: 110px;
  padding-bottom: 110px;
}

.contact-section > p {
  margin: 0 auto 28px;
}

.contact-note {
  font-size: 11px !important;
  margin-top: 15px !important;
}

.footer {
  border-top: 1px solid var(--border);
  padding: 30px 0;
}

.footer-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.footer p, .footer-inner > a:last-child {
  font-size: 11px;
  color: var(--muted);
}

@media (max-width: 800px) {
  .navbar nav { gap: 13px; }
  .navbar nav a { font-size: 11px; }
  .hero { grid-template-columns: 1fr; padding-top: 60px; }
  .hero-visual { margin: 20px auto; width: 90%; }
  .about-grid { grid-template-columns: 1fr; gap: 30px; }
  .experience-card { grid-template-columns: 1fr; gap: 15px; }
}

@media (max-width: 560px) {
  .navbar { height: auto; min-height: 75px; flex-wrap: wrap; gap: 15px; padding: 15px 5%; }
  .navbar nav { order: 3; width: 100%; justify-content: space-between; overflow-x: auto; }
  .navbar nav a { white-space: nowrap; }
  .nav-contact { font-size: 11px; }
  .hero h1 { letter-spacing: -2px; }
  .hero-buttons { flex-wrap: wrap; }
  .tech-inner { justify-content: center; padding: 25px 0; }
  .tech-inner span { font-size: 10px; }
  .skills-grid, .projects-grid { grid-template-columns: 1fr; }
  .floating-tag { font-size: 9px; padding: 9px; }
  .tag-top { right: -3%; }
  .tag-bottom { left: -3%; }
  .footer-inner { flex-direction: column; text-align: center; }
}
